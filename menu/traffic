#!/bin/bash

# ==================== WARNA ====================

NC='\033[0m'
RED='\033[0;31m'
YLW='\033[0;33m'
GRN='\033[0;32m'
CYA='\033[0;36m'

# ==================== SETUP ====================

_APISERVER=127.0.0.1:10000
_XRAY=/usr/local/bin/xray
LOGDIR="/user/bwlog"
COUNTERDIR="/user/bwcounter"

mkdir -p "$LOGDIR" "$COUNTERDIR"

# Reset setiap bulan
LAST_RESET_FILE="/user/.last_reset"
CURRENT_MONTH=$(date +%Y-%m)

# Kalau file tidak wujud, buat default kosong

[[ ! -f "$LAST_RESET_FILE" ]] && echo "1970-01" > "$LAST_RESET_FILE"

LAST_RESET=$(cat "$LAST_RESET_FILE")

if [[ "$CURRENT_MONTH" != "$LAST_RESET" ]]; then
echo "Reset log & counter for new month..."
rm -rf "$LOGDIR"/* "$COUNTERDIR"/*
echo "$CURRENT_MONTH" > "$LAST_RESET_FILE"
fi

# ==================== API FETCH ====================
apidata () {
    $_XRAY api statsquery --server=$_APISERVER "" 2>/dev/null \
    | awk '{
        if (match($1, /"name":/)) {
            f=1; gsub(/^"|link"|,$/, "", $2);
            split($2, p, ">>>");
            printf "%s:%s->%s\t", p[1],p[2],p[4];
        }
        else if (match($1, /"value":/) && f){
            f=0; gsub(/"/,"",$2); printf "%.0f\n",$2;
        }
        else if (match($0,/}/) && f){ f=0; print 0; }
    }'
}

# ==================== LOG & CALC ====================

log_user_data() {
local DATA="$1"
local TODAY=$(date +"%Y-%m-%d")
[[ -z "$DATA" ]] && return

echo "$DATA" | grep "^user" | while read -r line; do
    USER=$(echo "$line" | cut -d':' -f2 | cut -d'-' -f1)
    DIR=$(echo "$line" | cut -d'>' -f2 | cut -f1)
    VALUE=$(echo "$line" | awk '{print $2}')

    COUNTER="$COUNTERDIR/${USER}-${DIR}.txt"
    LOG="$LOGDIR/${USER}.log"

    OLD=0
    [[ -f "$COUNTER" ]] && OLD=$(cat "$COUNTER")

    DELTA=$((VALUE - OLD))
    [[ $DELTA -lt 0 ]] && DELTA=$VALUE

    echo "$VALUE" > "$COUNTER"
    echo "$TODAY $DIR $DELTA" >> "$LOG"
done

}

# ==================== LIVE OUTPUT ====================

print_live() {

local DATA="$1"

echo -e "${CYA}━━━━━━━━━━━━━━[ LIVE XRAY BANDWIDTH ]━━━━━━━━━━━━━━${NC}\n"

declare -A CURR PREV SPEED

# Parse API data
while read -r line; do

USER=$(echo "$line" | cut -d':' -f2 | cut -d'-' -f1)
VAL=$(echo "$line" | awk '{print $2}')

((CURR[$USER]+=VAL))

done <<< "$(echo "$DATA" | grep "^user")"

for U in "${!CURR[@]}"; do

CUR=${CURR[$U]}

CACHE="$SPEEDDIR/$U"

OLD=0
[[ -f "$CACHE" ]] && OLD=$(cat "$CACHE")

SPEED=$((CUR-OLD))
[[ $SPEED -lt 0 ]] && SPEED=0

echo "$CUR" > "$CACHE"

HR_SPEED=$(numfmt --to=iec --suffix=B $SPEED)

# warna ikut speed
if [[ $SPEED -ge 1000000 ]]; then COLOR=$RED
elif [[ $SPEED -ge 100000 ]]; then COLOR=$YLW
else COLOR=$GRN
fi

printf "%-18s : ${COLOR}%8s/s${NC}\n" "$U" "$HR_SPEED"

done | sort -k3 -hr

echo
}


# ==================== MONTHLY TOP ====================

print_monthly_top() {

echo -e "${CYA}━━━━━━━━━━━━━━━[ MONTHLY USAGE BY PROTOCOL ]━━━━━━━━━━━━━━${NC}\n"

XRAY_CFG="/usr/local/etc/xray/config.json"

TODAY=$(date +"%Y-%m-%d")
YDAY=$(date -d "yesterday" +"%Y-%m-%d")

declare -A MONTH
declare -A TODAYUSE
declare -A YDAYUSE
declare -A PROTO

# MAP USER → PROTOCOL
while read -r proto user; do
    PROTO["$user"]="$proto"
done < <(
sed -nE '
s/^#= ([^ ]+).*/vless \1/p
s/^#@ ([^ ]+).*/vmess \1/p
s/^#& ([^ ]+).*/trojan \1/p
s/^#! ([^ ]+).*/shadowsocks \1/p
s/^# ([^ ]+).*/socks \1/p
' "$XRAY_CFG" | sort -u
)

# KIRA LOG
for FILE in "$LOGDIR"/*.log; do
    [[ -f "$FILE" ]] || continue
    USER=$(basename "$FILE" .log)
    [[ -z "${PROTO[$USER]}" ]] && continue

    # convert to integer untuk handle scientific notation
    M_RAW=$(awk '{s+=$3} END{print s+0}' "$FILE")
    T_RAW=$(awk -v d="$TODAY" '$1==d {s+=$3} END{print s+0}' "$FILE")
    Y_RAW=$(awk -v d="$YDAY" '$1==d {s+=$3} END{print s+0}' "$FILE")

    MONTH["$USER"]=$(awk "BEGIN{printf \"%.0f\", $M_RAW}")
    TODAYUSE["$USER"]=$(awk "BEGIN{printf \"%.0f\", $T_RAW}")
    YDAYUSE["$USER"]=$(awk "BEGIN{printf \"%.0f\", $Y_RAW}")
done

for P in vless vmess trojan shadowsocks socks; do
    echo -e "${YLW}[$(echo "$P" | tr a-z A-Z)]${NC}"
    printf "%-20s %-10s %-10s %-10s\n" "USER" "TODAY" "YDAY" "MONTH"

    printf "%s\n" "${!MONTH[@]}" \
    | while read -r U; do
        [[ "${PROTO[$U]}" != "$P" ]] && continue
        echo "$U ${MONTH[$U]}"
    done | sort -k2 -nr | while read -r U T; do

        H_MONTH=$(numfmt --to=iec --suffix=B "$T")
        H_TODAY=$(numfmt --to=iec --suffix=B "${TODAYUSE[$U]:-0}")
        H_YDAY=$(numfmt --to=iec --suffix=B "${YDAYUSE[$U]:-0}")

        # COLOR BASED ON MONTH
        VAL=${MONTH[$U]}
        if [[ $VAL -ge 10000000000 ]]; then COLOR=$RED
        elif [[ $VAL -ge 1000000000 ]]; then COLOR=$YLW
        else COLOR=$GRN
        fi

        printf "%-20s ${COLOR}%-10s %-10s %-10s${NC}\n" "$U" "$H_TODAY" "$H_YDAY" "$H_MONTH"

    done
    echo
done

}

# ==================== MAIN ====================

DATA=$(apidata)
log_user_data "$DATA"
print_live "$DATA"
print_monthly_top

read -n1 -r -p " Press any key to continue..."
menu